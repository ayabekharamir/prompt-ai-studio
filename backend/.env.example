# =========================================================
# Prompt AI Studio - Backend Environment Variables[cite: 8]
# =========================================================
# Copy this file to `.env` (same directory) and fill in real values.[cite: 8]
# `.env` is git-ignored - never commit real secrets.[cite: 8]
#
# These variables are consumed by app/core/config.py (pydantic-settings).[cite: 8]
# When running via the repo-root docker-compose.yml, this same file is[cite: 8]
# also loaded by the `backend` and `frontend` services (env_file: .env[cite: 8]
# at the repo root) - see docker-compose.yml.[cite: 8]
# =========================================================

# --- General ---
ENVIRONMENT=development          # development | staging | production[cite: 8]
APP_NAME="Prompt AI Studio"[cite: 8]

# --- Database ---
# Local docker-compose default (matches docker-compose.yml postgres service).[cite: 8]
DATABASE_URL=postgresql://pas_user:change_me@localhost:5432/prompt_ai_studio[cite: 8]

# --- Auth / JWT ---
# Generate a strong random value for real environments, e.g.:[cite: 8]
#   openssl rand -hex 32[cite: 8]
SECRET_KEY=change_me_super_secret[cite: 8]
JWT_ALGORITHM=HS256[cite: 8]
ACCESS_TOKEN_EXPIRE_MINUTES=30[cite: 8]
REFRESH_TOKEN_EXPIRE_DAYS=30[cite: 8]

# --- CORS ---
# JSON array or comma-separated list of allowed origins.[cite: 8]
CORS_ORIGINS=["http://localhost:3000"][cite: 8]

# --- Security / Rate limiting preparation (Phase 1: prepared, not enforced) ---
# Comma-separated list of hostnames this API is allowed to serve.[cite: 8]
# Used by TrustedHostMiddleware; "*" (default) disables the check.[cite: 8]
ALLOWED_HOSTS=*[cite: 8]
# Toggle the in-memory rate limiter middleware. Off by default in Phase 1;[cite: 8]
# intended to be backed by Redis before production traffic.[cite: 8]
RATE_LIMIT_ENABLED=false[cite: 8]
RATE_LIMIT_PER_MINUTE=60[cite: 8]

# --- Logging ---
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR[cite: 8]
LOG_JSON=true                    # true = structured JSON logs, false = human-readable[cite: 8]

# --- SMS OTP (SMS.ir) - architecture ready, inactive by default ---
SMS_PROVIDER=sms_ir[cite: 8]
SMS_API_KEY=[cite: 8]
SMS_TEMPLATE_ID=[cite: 8]
SMS_SENDER_NUMBER=[cite: 8]
OTP_EXPIRE_SECONDS=120[cite: 8]
OTP_MAX_RETRY=5[cite: 8]

# --- OAuth (future) ---
GOOGLE_CLIENT_ID=[cite: 8]
GOOGLE_CLIENT_SECRET=[cite: 8]
APPLE_CLIENT_ID=[cite: 8]
APPLE_CLIENT_SECRET=[cite: 8]
MICROSOFT_CLIENT_ID=[cite: 8]
MICROSOFT_CLIENT_SECRET=[cite: 8]

# --- AI Providers (Phase 2B: active integration layer) ---
# AI_PROVIDER is the default provider used when a prompt execution request[cite: 8]
# does not explicitly override it. Leave as "none" to keep AI execution[cite: 8]
# disabled until you set a provider + matching API key below.[cite: 8]
AI_PROVIDER=none                 # none | openai | anthropic | gemini[cite: 8]

OPENAI_API_KEY=[cite: 8]
OPENAI_MODEL=gpt-4o-mini[cite: 8]

ANTHROPIC_API_KEY=[cite: 8]
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022[cite: 8]

GOOGLE_AI_API_KEY=[cite: 8]
GOOGLE_AI_MODEL=gemini-1.5-flash[cite: 8]

# --- Brand Assets storage (Phase: Brand Assets Foundation) ---[cite: 8]
# STORAGE_PROVIDER selects the backend behind the StorageProvider[cite: 8]
# abstraction (app/services/storage/). Only "local" (filesystem) is[cite: 8]
# implemented in this phase - deliberately provider-agnostic so PAS is not[cite: 8]
# tied to Railway/Cloudflare/Supabase/S3. A future S3-compatible provider[cite: 8]
# can be added later by switching this value, with no change to the API,[cite: 8]
# the brand_assets table, or the frontend.[cite: 8]
STORAGE_PROVIDER=local[cite: 8]

# Persistent, writable directory where uploaded brand asset files are[cite: 8]
# stored. MUST be a mounted volume/disk in production (this path is[cite: 8]
# ephemeral container storage otherwise, and uploads will be lost on[cite: 8]
# every redeploy/restart). On a plain Linux host (e.g. Miznbanfa), mount[cite: 8]
# or bind a persistent disk/directory at this path.[cite: 8]
STORAGE_LOCAL_PATH=/data/brand-assets[cite: 8]

# Max accepted upload size, in megabytes, for a single brand asset file.[cite: 8]
MAX_UPLOAD_SIZE_MB=8[cite: 8]

# =========================================================
# The following are consumed directly by docker-compose.yml[cite: 8]
# (postgres service + frontend NEXT_PUBLIC_API_URL), not by[cite: 8]
# app/core/config.py. Keep them in sync with DATABASE_URL above[cite: 8]
# when using docker-compose.[cite: 8]
# =========================================================
POSTGRES_USER=pas_user[cite: 8]
POSTGRES_PASSWORD=change_me[cite: 8]
POSTGRES_DB=prompt_ai_studio[cite: 8]
POSTGRES_PORT=5432[cite: 8]
