# =========================================================
# Prompt AI Studio - Backend Environment Variables
# =========================================================
# Copy this file to `.env` (same directory) and fill in real values.
# `.env` is git-ignored - never commit real secrets.
#
# These variables are consumed by app/core/config.py (pydantic-settings).
# When running via the repo-root docker-compose.yml, this same file is
# also loaded by the `backend` and `frontend` services (env_file: .env
# at the repo root) - see docker-compose.yml.
# =========================================================

# --- General ---
ENVIRONMENT=development          # development | staging | production
APP_NAME="Prompt AI Studio"

# --- Database ---
# Local docker-compose default (matches docker-compose.yml postgres service).
DATABASE_URL=postgresql://pas_user:change_me@localhost:5432/prompt_ai_studio

# --- Auth / JWT ---
# Generate a strong random value for real environments, e.g.:
#   openssl rand -hex 32
SECRET_KEY=change_me_super_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
# JSON array or comma-separated list of allowed origins.
CORS_ORIGINS=["http://localhost:3000"]

# --- Security / Rate limiting preparation (Phase 1: prepared, not enforced) ---
# Comma-separated list of hostnames this API is allowed to serve.
# Used by TrustedHostMiddleware; "*" (default) disables the check.
ALLOWED_HOSTS=*
# Toggle the in-memory rate limiter middleware. Off by default in Phase 1;
# intended to be backed by Redis before production traffic.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60

# --- Logging ---
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_JSON=true                    # true = structured JSON logs, false = human-readable

# --- SMS OTP (SMS.ir) - architecture ready, inactive by default ---
SMS_PROVIDER=sms_ir
SMS_API_KEY=
SMS_TEMPLATE_ID=
SMS_SENDER_NUMBER=
OTP_EXPIRE_SECONDS=120
OTP_MAX_RETRY=5

# --- OAuth (future) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- AI Providers (Phase 2B: active integration layer) ---
# AI_PROVIDER is the default provider used when a prompt execution request
# does not explicitly override it. Leave as "none" to keep AI execution
# disabled until you set a provider + matching API key below.
AI_PROVIDER=none                 # none | openai | anthropic | gemini

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-1.5-flash

# =========================================================
# The following are consumed directly by docker-compose.yml
# (postgres service + frontend NEXT_PUBLIC_API_URL), not by
# app/core/config.py. Keep them in sync with DATABASE_URL above
# when using docker-compose.
# =========================================================
POSTGRES_USER=pas_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=prompt_ai_studio
POSTGRES_PORT=5432
VITE_API_URL=https://prompt-ai-studio-production.up.railway.app
